<div style="position:relative;width:100%;height:100vh;min-height:600px;overflow:hidden;
background:radial-gradient(circle at 20% 30%, #0d1b2a 0%, #050c18 40%, #01040a 100%);
font-family:Segoe UI,Tahoma,Geneva,Verdana,sans-serif;color:white;">

    <!-- Canvas Fundo -->
    <canvas id="spaceCanvas" style="position:absolute;top:0;left:0;width:100%;height:100%;"></canvas>

    <!-- Conteúdo -->
    <div style="position:absolute;z-index:2;width:100%;top:50%;left:50%;
    transform:translate(-50%,-50%);text-align:center;padding:20px;">

        <div id="icon" style="font-size:60px;margin-bottom:20px;">
            📡
        </div>

        <h1 style="
            font-size:clamp(40px,6vw,80px);
            letter-spacing:4px;
            margin:0;
            animation: glow 3s ease-in-out infinite alternate;
        ">
            ESIP - Sistemas
        </h1>

        <p style="
            margin-top:20px;
            font-size:clamp(16px,2vw,24px);
            opacity:0.85;
            letter-spacing:2px;
        ">
            Gestão de segurança privada Tecnologia que conecta o mundo em um futuro tecnológico e Anti-fraude 
        </p>

        <!-- NOVO BOTÃO ABAIXO DO TEXTO -->
        <button id="accessBtn" onclick="window.open('https://sites.google.com/site/esipseguranca', '_blank')" 
        style="
            margin-top:25px;
            padding:12px 28px;
            font-size:clamp(16px,1.5vw,22px);
            color:#00ffff;
            border:2px solid #00ffff;
            border-radius:8px;
            background:transparent;
            cursor:pointer;
            transition:0.3s;
        ">
            🔐 + ACESSO
        </button>

    </div>
</div>

<style>
@keyframes glow {
    from {
        text-shadow: 0 0 20px #00bfff, 0 0 40px #0077ff;
    }
    to {
        text-shadow: 0 0 30px #33ccff, 0 0 80px #00bfff;
    }
}

@keyframes pulse {
    0% { transform: scale(1); text-shadow:0 0 20px #00bfff;}
    50% { transform: scale(1.2); text-shadow:0 0 40px #33ccff;}
    100% { transform: scale(1); text-shadow:0 0 20px #00bfff;}
}

#icon {
    animation: pulse 2.5s infinite;
}

/* Botão estilo hover neon */
#accessBtn:hover{
    background:#00ffff;
    color:#01040a;
    box-shadow: 0 0 20px #00ffff, 0 0 40px #33ccff;
    transform: scale(1.05);
}
</style>

<script>
(function(){
    const canvas = document.getElementById("spaceCanvas");
    const ctx = canvas.getContext("2d");

    function resize(){
        canvas.width = canvas.offsetWidth;
        canvas.height = canvas.offsetHeight;
    }
    window.addEventListener("resize", resize);
    resize();

    const stars = [];
    const meteors = [];
    const nodes = [];

    for(let i=0;i<200;i++){
        stars.push({
            x: Math.random()*canvas.width,
            y: Math.random()*canvas.height,
            size: Math.random()*2,
            opacity: Math.random()
        });
    }

    for(let i=0;i<30;i++){
        nodes.push({
            x: Math.random()*canvas.width,
            y: Math.random()*canvas.height,
            vx:(Math.random()-0.5)*0.5,
            vy:(Math.random()-0.5)*0.5
        });
    }

    function createMeteor(){
        meteors.push({
            x: Math.random()*canvas.width,
            y: -50,
            length: Math.random()*100+50,
            speed: Math.random()*6+4,
            opacity: Math.random()*0.8+0.2
        });
    }

    function draw(){
        ctx.clearRect(0,0,canvas.width,canvas.height);

        stars.forEach(s=>{
            ctx.fillStyle="rgba(255,255,255,"+s.opacity+")";
            ctx.fillRect(s.x,s.y,s.size,s.size);
        });

        nodes.forEach(n=>{
            n.x+=n.vx;
            n.y+=n.vy;
            if(n.x<0||n.x>canvas.width) n.vx*=-1;
            if(n.y<0||n.y>canvas.height) n.vy*=-1;
            ctx.fillStyle="#00bfff";
            ctx.beginPath();
            ctx.arc(n.x,n.y,2,0,Math.PI*2);
            ctx.fill();
        });

        for(let i=0;i<nodes.length;i++){
            for(let j=i+1;j<nodes.length;j++){
                const dx=nodes[i].x-nodes[j].x;
                const dy=nodes[i].y-nodes[j].y;
                const dist=Math.sqrt(dx*dx+dy*dy);
                if(dist<120){
                    ctx.strokeStyle="rgba(0,191,255,"+(1-dist/120)+")";
                    ctx.lineWidth=0.5;
                    ctx.beginPath();
                    ctx.moveTo(nodes[i].x,nodes[i].y);
                    ctx.lineTo(nodes[j].x,nodes[j].y);
                    ctx.stroke();
                }
            }
        }

        meteors.forEach((m,i)=>{
            ctx.beginPath();
            ctx.moveTo(m.x,m.y);
            ctx.lineTo(m.x+m.length*0.4,m.y+m.length);
            ctx.strokeStyle="rgba(255,255,255,"+m.opacity+")";
            ctx.lineWidth=2;
            ctx.stroke();
            m.y+=m.speed;
            m.x+=m.speed*0.4;
            if(m.y>canvas.height){
                meteors.splice(i,1);
            }
        });

        requestAnimationFrame(draw);
    }

    setInterval(createMeteor,300);
    draw();
})();
</script>
