<!DOCTYPE html>
<html lang="pt-BR">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="LinkPro — crie e publique seu cartão digital."
  >

  <title>LinkPro — Seu cartão digital</title>

  <link rel="stylesheet" href="style.css">

</head>

<body>

<div class="app">

  <!-- ==========================================
       SIDEBAR
  =========================================== -->

  <aside class="sidebar">

    <div class="brand">

      <div class="brand-icon">
        🔗
      </div>

      <div>
        <strong>LinkPro</strong>
        <span>Cartão digital</span>
      </div>

    </div>


    <nav aria-label="Navegação principal">

      <button
        class="nav-item active"
        type="button"
        data-section="perfil"
      >
        👤 Perfil
      </button>

      <button
        class="nav-item"
        type="button"
        data-section="links"
      >
        🔗 Meus links
      </button>

      <button
        class="nav-item"
        type="button"
        data-section="aparencia"
      >
        🎨 Aparência
      </button>

      <button
        class="nav-item"
        type="button"
        data-section="publicar"
      >
        🚀 Publicar
      </button>

    </nav>


    <div class="sidebar-bottom">

      <button
        class="save-btn"
        id="saveBtn"
        type="button"
      >
        💾 Salvar
      </button>

      <button
        class="reset-btn"
        id="resetBtn"
        type="button"
      >
        ↻ Restaurar
      </button>

    </div>

  </aside>


  <!-- ==========================================
       CONTEÚDO PRINCIPAL
  =========================================== -->

  <main class="content">

    <header class="topbar">

      <div>

        <h1 id="sectionTitle">
          Meu perfil
        </h1>

        <p id="sectionDescription">
          Configure as informações do seu cartão digital.
        </p>

      </div>


      <div
        class="status"
        id="saveStatus"
        aria-live="polite"
      >

        <span></span>

        Salvo localmente

      </div>

    </header>


    <!-- ========================================
         PERFIL
    ========================================= -->

    <section
      class="editor-section active"
      id="perfil"
    >

      <div class="card">

        <div class="card-title">

          <div>

            <h2>
              Informações do perfil
            </h2>

            <p>
              Essas informações aparecem na sua página pública.
            </p>

          </div>

        </div>


        <div class="avatar-editor">

          <div
            class="big-avatar"
            id="editorAvatar"
          >
            ?
          </div>


          <div>

            <strong>
              Foto do perfil
            </strong>

            <p>
              Você pode adicionar uma foto abaixo.
            </p>

            <input
              type="file"
              id="avatarInput"
              accept="image/*"
            >

          </div>

        </div>


        <div class="form-grid">

          <div class="form-group">

            <label for="profileName">
              Nome profissional
            </label>

            <input
              id="profileName"
              type="text"
              maxlength="100"
              autocomplete="name"
              placeholder="Ex: João Silva"
            >

          </div>


          <div class="form-group">

            <label for="profileJob">
              Profissão
            </label>

            <input
              id="profileJob"
              type="text"
              maxlength="100"
              placeholder="Ex: Fotógrafo"
            >

          </div>

        </div>


        <div class="form-group">

          <label for="profileBio">
            Descrição
          </label>

          <textarea
            id="profileBio"
            maxlength="500"
            placeholder="Conte um pouco sobre você..."
            rows="4"
          ></textarea>

        </div>

      </div>

    </section>


    <!-- ========================================
         LINKS
    ========================================= -->

    <section
      class="editor-section"
      id="links"
    >

      <div class="section-heading">

        <div>

          <h2>
            Meus links
          </h2>

          <p>
            Adicione os lugares onde seus clientes podem encontrar você.
          </p>

        </div>


        <button
          class="primary-btn"
          id="addLinkBtn"
          type="button"
        >
          + Adicionar link
        </button>

      </div>


      <div id="linksContainer"></div>

    </section>


    <!-- ========================================
         APARÊNCIA
    ========================================= -->

    <section
      class="editor-section"
      id="aparencia"
    >

      <div class="card">

        <div class="card-title">

          <div>

            <h2>
              Personalização
            </h2>

            <p>
              Deixe seu cartão com a sua identidade.
            </p>

          </div>

        </div>


        <div class="theme-grid">

          <button
            class="theme-card"
            type="button"
            data-theme="blue"
          >
            <span style="background:#2563eb"></span>
            Azul
          </button>


          <button
            class="theme-card"
            type="button"
            data-theme="purple"
          >
            <span style="background:#7c3aed"></span>
            Roxo
          </button>


          <button
            class="theme-card"
            type="button"
            data-theme="green"
          >
            <span style="background:#059669"></span>
            Verde
          </button>


          <button
            class="theme-card"
            type="button"
            data-theme="orange"
          >
            <span style="background:#ea580c"></span>
            Laranja
          </button>


          <button
            class="theme-card"
            type="button"
            data-theme="black"
          >
            <span style="background:#111827"></span>
            Preto
          </button>

        </div>


        <div class="custom-colors">

          <div>

            <label for="buttonColor">
              Cor dos botões
            </label>

            <input
              type="color"
              id="buttonColor"
              value="#2563eb"
            >

          </div>


          <div>

            <label for="backgroundColor">
              Cor de fundo
            </label>

            <input
              type="color"
              id="backgroundColor"
              value="#f8fafc"
            >

          </div>

        </div>

      </div>

    </section>


    <!-- ========================================
         PUBLICAR
    ========================================= -->

    <section
      class="editor-section"
      id="publicar"
    >

      <div class="card publish-card">

        <div class="publish-icon">
          🚀
        </div>


        <h2>
          Seu cartão está pronto!
        </h2>


        <p>
          Gere uma página HTML independente para
          publicar no GitHub Pages ou em qualquer
          hospedagem.
        </p>


        <div class="publish-actions">

          <button
            class="primary-btn"
            id="generatePageBtn"
            type="button"
          >
            📄 Gerar página HTML
          </button>


          <button
            class="secondary-btn"
            id="generateButtonBtn"
            type="button"
          >
            🔗 Gerar botão
          </button>

        </div>


        <div class="publish-info">

          <div>

            <strong>
              GitHub Pages
            </strong>

            <span>
              Compatível
            </span>

          </div>


          <div>

            <strong>
              Banco externo
            </strong>

            <span>
              Não necessário
            </span>

          </div>


          <div>

            <strong>
              Dados locais
            </strong>

            <span>
              IndexedDB
            </span>

          </div>

        </div>

      </div>

    </section>

  </main>


  <!-- ==========================================
       PRÉ-VISUALIZAÇÃO
  =========================================== -->

  <aside class="preview-area">

    <div class="preview-label">
      PRÉ-VISUALIZAÇÃO
    </div>


    <div class="phone">

      <div
        class="phone-screen"
        id="phoneScreen"
      >

        <div
          class="profile-avatar"
          id="previewAvatar"
        >
          ?
        </div>


        <h2 id="previewName">
          Seu Nome
        </h2>


        <div
          class="preview-job"
          id="previewJob"
        >
          Sua profissão
        </div>


        <p
          class="preview-bio"
          id="previewBio"
        >
          Sua descrição aparecerá aqui.
        </p>


        <div id="previewLinks"></div>


        <div class="preview-brand">
          Criado com LinkPro
        </div>

      </div>

    </div>

  </aside>

</div>


<!-- ==========================================
     MODAL DE CÓDIGO
=========================================== -->

<div
  class="modal"
  id="modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modalTitle"
>

  <div class="modal-box">

    <button
      class="modal-close"
      id="closeModal"
      type="button"
      aria-label="Fechar"
    >
      ×
    </button>


    <h2 id="modalTitle">
      Código gerado
    </h2>


    <p id="modalDescription"></p>


    <textarea
      id="generatedCode"
      readonly
      aria-label="Código gerado"
    ></textarea>


    <button
      class="primary-btn full"
      id="copyCodeBtn"
      type="button"
    >
      📋 Copiar código
    </button>


    <button
      class="secondary-btn full"
      id="downloadBtn"
      type="button"
    >
      📥 Baixar arquivo
    </button>

  </div>

</div>


<!-- ==========================================
     NOTIFICAÇÃO
=========================================== -->

<div
  class="toast"
  id="toast"
  role="status"
  aria-live="polite"
>
  Salvo com sucesso!
</div>


<!-- ==========================================
     JAVASCRIPT
=========================================== -->

<script src="script.js"></script>

</body>

</html>
